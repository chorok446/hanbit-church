# 교회 실제 인적사항. 이 파일을 .env.local로 복사해 실제 값을 채운다.
# NEXT_PUBLIC_* 은 빌드 시 클라이언트 번들에 인라인된다(공개 페이지에 표시되는 값만 둘 것).
# 운영 Docker 빌드: 같은 이름의 GitHub Repository Variables/build args로 전달한다(.env.local 자동 전달 안 됨).
# 필수: API_URL, SITE_URL, CHURCH_NAME, CHURCH_ADDRESS, CHURCH_PHONE(모두 NEXT_PUBLIC_ 접두사).
NEXT_PUBLIC_CHURCH_NAME=
NEXT_PUBLIC_CHURCH_NAME_EN=
NEXT_PUBLIC_CHURCH_PASTOR=
NEXT_PUBLIC_CHURCH_ADDRESS=
NEXT_PUBLIC_CHURCH_PHONE=
NEXT_PUBLIC_CHURCH_EMAIL=
# 카카오맵 JavaScript API 키 — 미설정 시 오시는길 지도가 자리표시로 대체된다
NEXT_PUBLIC_KAKAO_MAP_KEY=
# 교회 SNS·채널 링크 — 미설정 시 푸터에서 해당 아이콘이 숨겨진다
NEXT_PUBLIC_CHURCH_YOUTUBE=
NEXT_PUBLIC_CHURCH_INSTAGRAM=
NEXT_PUBLIC_CHURCH_KAKAO=
# 헌금 계좌 안내 — 미설정 시 /giving 에서 "교회 사무실 문의" 안내로 대체된다
NEXT_PUBLIC_CHURCH_BANK=
NEXT_PUBLIC_CHURCH_ACCOUNT=
NEXT_PUBLIC_CHURCH_ACCOUNT_HOLDER=
# 간편송금 딥링크(전체 URL) — 교회가 발급한 카카오페이/토스 송금 링크. 미설정 시 해당 버튼이 숨겨진다
NEXT_PUBLIC_CHURCH_KAKAOPAY=
NEXT_PUBLIC_CHURCH_TOSS=

# 사이트 기본 URL — 메타데이터(og:url·sitemap·canonical) 절대 주소 생성에 사용
NEXT_PUBLIC_SITE_URL=

# API 주소 — 브라우저용(기본 http://localhost:8080)과 SSR 내부 호출용(도커 네트워크 등)
NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=

# Sentry 에러 추적 — 미설정 시 SDK 완전 비활성(번들에도 로드 안 됨)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
