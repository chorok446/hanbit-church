# Production Web image (GHCR build). pnpm 모노레포 루트를 build context 로 사용한다.
# NEXT_PUBLIC_API_URL 은 build arg 로 주입한다(운영 URL 하드코딩 없음).
# 로컬 개발용은 apps/web/Dockerfile + compose.local.yml 을 사용한다.
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate

FROM base AS builder
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web apps/web

RUN pnpm install --frozen-lockfile --filter web

ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
# 프로덕션 이미지에서만 standalone 번들을 생성한다(next.config.ts 의 env 게이트).
ENV NEXT_OUTPUT_STANDALONE=1

RUN pnpm --filter web build

FROM base AS runner
# SSR 날짜 로직·로그 타임스탬프 — 코드가 KST 고정이어도 로그·미래 코드 안전망.
ENV TZ=Asia/Seoul
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Ship the Next.js standalone bundle (output: "standalone" in next.config.ts) instead of the
# whole workspace node_modules + `pnpm start`. In this pnpm monorepo the traced output nests
# under apps/web/, so server.js lands at /app/apps/web/server.js and static/public sit beside it.
COPY --chown=node:node --from=builder /app/apps/web/.next/standalone ./
COPY --chown=node:node --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --chown=node:node --from=builder /app/apps/web/public ./apps/web/public

USER node

EXPOSE 3000
# node images have neither wget nor curl in bookworm-slim; use node's built-in http client.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:3000/',r=>process.exit(r.statusCode<500?0:1)).on('error',()=>process.exit(1))"
CMD ["node", "apps/web/server.js"]
