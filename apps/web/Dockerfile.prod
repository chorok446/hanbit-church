# Production Web image (Docker Hub build). pnpm 모노레포 루트를 build context 로 사용한다.
# NEXT_PUBLIC_* 은 공개 값만 build arg 로 주입한다. 런타임 env 로는 번들을 바꿀 수 없다.
# 로컬 개발용은 apps/web/Dockerfile + compose.local.yml 을 사용한다.
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate

FROM base AS builder
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web apps/web

ARG WEB_BUILD_MODE=production
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_CHURCH_NAME
ARG NEXT_PUBLIC_CHURCH_NAME_EN
ARG NEXT_PUBLIC_CHURCH_PASTOR
ARG NEXT_PUBLIC_CHURCH_ADDRESS
ARG NEXT_PUBLIC_CHURCH_PHONE
ARG NEXT_PUBLIC_CHURCH_EMAIL
ARG NEXT_PUBLIC_KAKAO_MAP_KEY
ARG NEXT_PUBLIC_CHURCH_YOUTUBE
ARG NEXT_PUBLIC_CHURCH_INSTAGRAM
ARG NEXT_PUBLIC_CHURCH_KAKAO
ARG NEXT_PUBLIC_CHURCH_BANK
ARG NEXT_PUBLIC_CHURCH_ACCOUNT
ARG NEXT_PUBLIC_CHURCH_ACCOUNT_HOLDER
ARG NEXT_PUBLIC_CHURCH_KAKAOPAY
ARG NEXT_PUBLIC_CHURCH_TOSS
ARG NEXT_PUBLIC_SENTRY_DSN
ARG NEXT_PUBLIC_SENTRY_ENVIRONMENT
ENV WEB_BUILD_MODE=$WEB_BUILD_MODE \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_CHURCH_NAME=$NEXT_PUBLIC_CHURCH_NAME \
    NEXT_PUBLIC_CHURCH_NAME_EN=$NEXT_PUBLIC_CHURCH_NAME_EN \
    NEXT_PUBLIC_CHURCH_PASTOR=$NEXT_PUBLIC_CHURCH_PASTOR \
    NEXT_PUBLIC_CHURCH_ADDRESS=$NEXT_PUBLIC_CHURCH_ADDRESS \
    NEXT_PUBLIC_CHURCH_PHONE=$NEXT_PUBLIC_CHURCH_PHONE \
    NEXT_PUBLIC_CHURCH_EMAIL=$NEXT_PUBLIC_CHURCH_EMAIL \
    NEXT_PUBLIC_KAKAO_MAP_KEY=$NEXT_PUBLIC_KAKAO_MAP_KEY \
    NEXT_PUBLIC_CHURCH_YOUTUBE=$NEXT_PUBLIC_CHURCH_YOUTUBE \
    NEXT_PUBLIC_CHURCH_INSTAGRAM=$NEXT_PUBLIC_CHURCH_INSTAGRAM \
    NEXT_PUBLIC_CHURCH_KAKAO=$NEXT_PUBLIC_CHURCH_KAKAO \
    NEXT_PUBLIC_CHURCH_BANK=$NEXT_PUBLIC_CHURCH_BANK \
    NEXT_PUBLIC_CHURCH_ACCOUNT=$NEXT_PUBLIC_CHURCH_ACCOUNT \
    NEXT_PUBLIC_CHURCH_ACCOUNT_HOLDER=$NEXT_PUBLIC_CHURCH_ACCOUNT_HOLDER \
    NEXT_PUBLIC_CHURCH_KAKAOPAY=$NEXT_PUBLIC_CHURCH_KAKAOPAY \
    NEXT_PUBLIC_CHURCH_TOSS=$NEXT_PUBLIC_CHURCH_TOSS \
    NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN \
    NEXT_PUBLIC_SENTRY_ENVIRONMENT=$NEXT_PUBLIC_SENTRY_ENVIRONMENT

# 설정 누락은 의존성 설치/Next 빌드 전에 실패한다. verification은 push하지 않는 PR 검증에만 사용.
RUN node apps/web/scripts/validate-build-config.mjs
RUN pnpm install --frozen-lockfile --filter web

# 프로덕션 이미지에서만 standalone 번들을 생성한다(next.config.ts 의 env 게이트).
ENV NEXT_OUTPUT_STANDALONE=1

RUN pnpm --filter web build

FROM base AS runner
# SSR 날짜 로직·로그 타임스탬프 — 코드가 KST 고정이어도 로그·미래 코드 안전망.
ENV TZ=Asia/Seoul
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Ship the Next.js standalone bundle (output: "standalone" in next.config.ts) instead of the
# whole workspace node_modules + `pnpm start`. In this pnpm monorepo the traced output nests
# under apps/web/, so server.js lands at /app/apps/web/server.js and static/public sit beside it.
COPY --chown=node:node --from=builder /app/apps/web/.next/standalone ./
COPY --chown=node:node --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --chown=node:node --from=builder /app/apps/web/public ./apps/web/public

USER node

EXPOSE 3000
# node images have neither wget nor curl in bookworm-slim; use node's built-in http client.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:3000/',r=>process.exit(r.statusCode<500?0:1)).on('error',()=>process.exit(1))"
CMD ["node", "apps/web/server.js"]
