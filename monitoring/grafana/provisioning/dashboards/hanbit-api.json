{
  "title": "한빛교회 API",
  "uid": "hanbit-api",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP 요청률 (req/s, URI별)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"hanbit-api\"}[5m]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP p95 지연 (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"hanbit-api\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "5xx 에러율 (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum (rate(http_server_requests_seconds_count{application=\"hanbit-api\", status=~\"5..\"}[5m]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 4,
      "title": "JVM 힙 사용량",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "sum (jvm_memory_used_bytes{application=\"hanbit-api\", area=\"heap\"})",
          "legendFormat": "used"
        },
        {
          "expr": "sum (jvm_memory_max_bytes{application=\"hanbit-api\", area=\"heap\"})",
          "legendFormat": "max"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 5,
      "title": "HikariCP 커넥션 (active/idle/pending)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        { "expr": "hikaricp_connections_active{application=\"hanbit-api\"}", "legendFormat": "active" },
        { "expr": "hikaricp_connections_idle{application=\"hanbit-api\"}", "legendFormat": "idle" },
        { "expr": "hikaricp_connections_pending{application=\"hanbit-api\"}", "legendFormat": "pending" }
      ]
    }
  ],
  "schemaVersion": 39
}
